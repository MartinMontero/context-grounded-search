# =============================================================================
# contextual-rag — environment template
# Copy to .env and fill in every "change-me" value. Never commit .env.
# Generate secrets with:  openssl rand -hex 32
# =============================================================================

# --- PostgreSQL (backs n8n) ---------------------------------------------------
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag
N8N_DB_NAME=n8n

# --- Redis (n8n Bull queue on db 0, RAG rate-limit + DLQ on db 1) -----------
REDIS_PASSWORD=change-me

# --- Qdrant ------------------------------------------------------------------
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=documents
QDRANT_IMAGE_TAG=v1.19.1

# --- n8n ---------------------------------------------------------------------
N8N_IMAGE_TAG=2.40.1
# Must be identical on main, worker and webhook instances (credential decryption).
N8N_ENCRYPTION_KEY=change-me
# Public base URL used to build webhook URLs on EVERY instance (main + workers +
# webhook processors). Without this, workers resolve webhooks to localhost:5678.
N8N_WEBHOOK_URL=http://localhost:5678
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_HOST=localhost
N8N_PROTOCOL=http
TZ=UTC

# --- Service-to-service auth (HS256 JWT shared by all services + n8n) --------
SERVICE_JWT_SECRET=change-me
SERVICE_JWT_ISSUER=contextual-rag
SERVICE_JWT_AUDIENCE=rag-services

# --- Anthropic (contextual chunking) ----------------------------------------
ANTHROPIC_API_KEY=
# claude-3-5-haiku-20241022 (2048-token cache minimum) was retired 2026-02-19.
# Haiku 4.5 is the current Haiku generation; its prompt-cache minimum is 4096.
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_CACHE_MIN_TOKENS=4096
ANTHROPIC_MAX_CONCURRENCY=4

# --- Cohere (reranking) ------------------------------------------------------
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro

# --- OpenAI (RAGAS answer_relevancy embeddings; optional, FastEmbed fallback) -
OPENAI_API_KEY=
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
# ragas 0.4.x hard-codes temperature/top_p, which Opus 5 / Sonnet 5 reject;
# Haiku 4.5 accepts them, so it is the judge model that works out of the box.
RAGAS_JUDGE_MODEL=claude-haiku-4-5

# --- FastEmbed models (must match the Qdrant vector config) ------------------
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
COLBERT_MODEL=colbert-ir/colbertv2.0

# --- HTTP hardening -----------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1,extraction-service,chunking-service,retrieval-service
CORS_ALLOW_ORIGINS=http://localhost:5678
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Extraction / SSRF ---------------------------------------------------------
EXTRACTION_MAX_PAYLOAD_BYTES=10485760
EXTRACTION_FETCH_TIMEOUT_SECONDS=15
EXTRACTION_MAX_REDIRECTS=3

# --- Observability -------------------------------------------------------------
# Empty disables OTLP export (spans are still created; logs stay JSON).
# Set to http://jaeger:4317 ONLY when running `docker compose --profile observability up`,
# otherwise the exporter retries against a hostname that does not resolve.
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
